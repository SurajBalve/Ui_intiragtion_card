		"configuration": {
			"parameters": {
				"firstName": {
					"value": "Suraj",
					"type": "string",
					"label": "Workzone user First name",
					"description": "First name of the logged-in Workzone user"
				},
				"category" : {
					"value": "category",
					"label": "Color"
				}
			}
		}
	},
	"sap.platform.mobilecards": {
		"compatible": true
	}
}