<mvc:View xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc"
          xmlns="sap.m" xmlns:html="http://www.w3.org/1999/xhtml"
          width="100%"
          xmlns:viz="sap.viz.ui5.controls"
          xmlns:viz.data="sap.viz.ui5.data"
          xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
          displayBlock="true"
          controllerName="ns.Analitical_card.Card">
            <VBox width="100%" class="sapUiSmallMargin">
                <viz:VizFrame
                    id="idWorkStatusChart"
                    vizType="bar"
                    uiConfig="{applicationSet:'fiori'}"
                    width="100%"
                    height="320px">
                      <viz:dataset>
                          <viz.data:FlattenedDataset data="{chart>/WorkStatus}">
                              <viz.data:dimensions>
                                  <viz.data:DimensionDefinition name="Status" value="{chart>Status}" />
                              </viz.data:dimensions>
                              <viz.data:measures>
                                  <viz.data:MeasureDefinition name="Tasks" value="{chart>Count}" />
                              </viz.data:measures>
                          </viz.data:FlattenedDataset>
                      </viz:dataset>
                      <viz:feeds>
                            <viz.feeds:FeedItem
                              uid="valueAxis"
                              type="Measure"
                              values="Tasks" />
                            <viz.feeds:FeedItem
                            uid="categoryAxis"
                            type="Dimension"
                            values="Status" />
                      </viz:feeds>
                </viz:VizFrame>
            </VBox>
</mvc:View>
